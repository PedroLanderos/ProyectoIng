					]
				}
			},
			"response": []
		},
		{
			"name": "Login User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Guardar token y userId como variables globales\", function () {",
							"    let jsonData = pm.response.json();",
							"",
							"    if (jsonData && jsonData.message) {",
							"        const token = jsonData.message;",
							"        pm.globals.set(\"token\", token);",
							"",
							"        // Decodificar el payload del JWT",
							"        const base64Payload = token.split('.')[1];",
							"        const payload = JSON.parse(atob(base64Payload));",
							"",
							"        // Extraer el ID del usuario (ajusta el nombre si es diferente)",
							"        const userId = payload[\"UserId\"] || payload[\"userId\"] || payload[\"sub\"];",
							"        if (userId) {",
							"            pm.globals.set(\"userId\", userId);",
							"            console.log(\"userId extraído:\", userId);",
							"        } else {",
							"            console.warn(\"No se encontró userId en el token\");",
							"        }",
							"    } else {",
							"        console.warn(\"Token no encontrado en la respuesta\");",
							"    }",
							"});",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"Email\": \"juan@example.com\",\n    \"Password\": \"PasswordSegura123!\"\n}"
				},
				"url": {
					"raw": "http://localhost:5003/api/authentication/login",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "5003",
					"path": [
						"api",
						"authentication",
						"login"
					]
				}
			},
			"response": []
		},
