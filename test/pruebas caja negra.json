		{
			"name": "Register User",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Código de estado 200 o 400\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
							"});",
							"pm.test(\"Respuesta contiene estructura esperada\", function () {",
							"    let jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property(\"flag\");",
							"    pm.expect(jsonData).to.have.property(\"message\");",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"let counter = parseInt(pm.globals.get(\"emailCounter\") || \"1\", 10);\r",
							"let email = `juan${counter}@example.com`;\r",
							"\r",
							"// Guardar como variable global para usar en el body\r",
							"pm.globals.set(\"dynamicEmail\", email);\r",
							"\r",
							"// Incrementar el contador para la próxima vez\r",
							"pm.globals.set(\"emailCounter\", counter + 1);\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"Id\": 0,\n  \"Name\": \"Juan Pérez\",\n  \"TelephoneNumber\": \"123456789\",\n  \"Address\": \"Calle Falsa 123\",\n  \"Email\": \"{{dynamicEmail}}\",\n  \"Password\": \"PasswordSegura123!\",\n  \"Role\": \"User\"\n}\n"
				},
				"url": {
					"raw": "http://localhost:5003/api/authentication/register",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "5003",
